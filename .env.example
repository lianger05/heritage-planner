# Docker Compose 环境变量模板
# 复制为 .env 并填入实际值

# PostgreSQL
POSTGRES_USER=heritage
POSTGRES_PASSWORD=         # 必填：设置强密码
POSTGRES_DB=heritage_planner

# Neo4j
NEO4J_PASSWORD=            # 必填：设置强密码

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=       # 必填：设置强密码

# LLM API Keys（至少配置一个）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# Backend
API_KEY=                   # 写操作认证密钥（生产环境必填）
APP_SECRET_KEY=            # 应用密钥（生产环境必填）
