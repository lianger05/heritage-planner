# ==============================
# 古建文旅经济智能规划助手
# Heritage Cultural Tourism AI Planner
# ==============================

# ----- LLM Configuration -----
# DeepSeek API (primary)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Qwen API (fallback)
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI-compatible endpoint (universal fallback)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://heritage:heritage123@localhost:5432/heritage_planner
DATABASE_URL_SYNC=postgresql://heritage:heritage123@localhost:5432/heritage_planner

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- Neo4j (Knowledge Graph) -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=heritage2024

# ----- ChromaDB (Vector Store) -----
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ----- MinIO (File Storage) -----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=heritage-planner

# ----- Amap (Map API) -----
AMAP_API_KEY=your-amap-api-key
AMAP_SECURITY_KEY=your-amap-security-key

# ----- App Settings -----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- LLM Cache -----
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600
