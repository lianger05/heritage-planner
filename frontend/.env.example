# ==============================
# 古建文旅规划助手 - 前端环境变量
# 复制为 .env.local 并填入实际值
# ==============================

# ----- API 后端地址 -----
# Vercel 生产部署：指向 Render 后端
# NEXT_PUBLIC_API_URL=https://heritage-planner.onrender.com/api/v1
# 本地开发：留空，由 next.config.js rewrites 代理到 localhost:8080
NEXT_PUBLIC_API_URL=/api/v1

# ----- 高德地图 JS API 2.0 -----
# 获取方式：https://console.amap.com/dev/key/app
# ⚠️ 安全提醒：务必在 AMap 控制台配置以下安全策略：
#   1. HTTP Referer 白名单：限制为你的域名（如 *.vercel.app, localhost:3000）
#   2. IP 白名单（可选）：限制后端服务器 IP
#   3. 应用类型选择 "Web端(JS API)"
#   4. 不要将 Key 提交到公开仓库
NEXT_PUBLIC_AMAP_KEY=your-amap-jsapi-key
NEXT_PUBLIC_AMAP_SECRET=your-amap-security-code
